# Public site URL (used for canonical URLs, sitemap, OpenGraph). Also set siteConfig.url.
NEXT_PUBLIC_SITE_URL=https://mhd-auto.example.com

# Contact form e-mail delivery via Resend (https://resend.com). Leave empty to disable e-mail;
# the form still returns a pre-filled WhatsApp link.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@mhd-auto.example.com
CONTACT_FROM_EMAIL="MHD AUTO <site@mhd-auto.example.com>"
